<resources>
  <style name="PlayerTheme" parent="Theme.AppCompat.NoActionBar">
    <item name="android:windowBackground">@android:color/black</item>
    <item name="android:fontFamily">sans</item>
  </style>

  <style name="PlayerControlButton">
    <item name="android:layout_width">58dp</item>
    <item name="android:layout_height">40dp</item>
    <item name="android:backgroundTint">#1B2733</item>
    <item name="android:minHeight">40dp</item>
    <item name="android:minWidth">0dp</item>
    <item name="android:paddingLeft">4dp</item>
    <item name="android:paddingRight">4dp</item>
    <item name="android:singleLine">true</item>
    <item name="android:textAllCaps">false</item>
    <item name="android:textColor">#FFFFFFFF</item>
    <item name="android:textSize">13sp</item>
  </style>

  <style name="PlayerPrimaryButton" parent="PlayerControlButton">
    <item name="android:layout_width">72dp</item>
    <item name="android:backgroundTint">#2E5AAC</item>
  </style>

  <style name="PlayerMenuButton" parent="PlayerControlButton">
    <item name="android:layout_width">76dp</item>
  </style>
</resources>
